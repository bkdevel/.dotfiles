.tcshrc:
cowsay -f stegosaurus "Willkomen, $USER, in der tcsh auf `lsb_release -d | cut -f2-`"
fortune


eval `starship init tcsh`


## tcsh propmpt
set prompt = "%n@%m: < %~ > % "

## environment vars
setenv EDITOR vim
setenv VISUAL vim
setenv PAGER  less
setenv SHELL  tcsh


#
## aliases
#

alias l  "ls -l --color"
alias la "ls -la --color"
alias al "ls -la --color"
alias ls "ls --color"
alias sl "ls --color"

alias e2l  "e2ls -l"
alias e2la "e2ls -la"

alias sysfetch "fastfetch"
alias fetch "fastfetch"

alias gnuplot "gnuplot -p"

alias menu "rofi -show run"
alias m "rofi -show run"
alias run "rofi -show run"

alias power "upower -i /org/freedesktop/UPower/devices/battery_BAT0"
